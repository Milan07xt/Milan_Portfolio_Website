# Google Gemini API Key for AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration for Contact Form Notifications
# Generate an App Password from your Google Account Security settings
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# WhatsApp notification recipient (CallMeBot)
# Activate CallMeBot on 919327599254, then add the API key it sends you.
CALLMEBOT_API_KEY=your_callmebot_api_key

# Optional SMS provider credentials for Africa's Talking
SMS_USERNAME=sandbox
SMS_API_KEY=your_africas_talking_api_key

# Optional: specify a custom Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Optional: deployment URL for the AI backend
# AI_BACKEND_URL=https://your-backend-name.onrender.com
